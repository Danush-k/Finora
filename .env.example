# ==========================================
# Finora by PayTrace - Environment Variables
# ==========================================

# MongoDB Database URI (Defaults to local MongoDB on port 27017, or replace with MongoDB Atlas M0 URI)
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/finora_paytrace
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/finora_paytrace?retryWrites=true&w=majority

# Google Cloud OAuth 2.0 Credentials (for Gmail API integration)
# Follow the instructions in the Settings page or README to generate these
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/gmail/callback
FRONTEND_REDIRECT_URL=http://localhost:3000/settings

# Sync Configuration
# Sync interval in milliseconds (e.g. 120000 = 2 minutes, 60000 = 1 minute)
GMAIL_SYNC_DELAY_MS=120000
GMAIL_SYNC_ENABLED=true
HDFC_SENDER_EMAILS=alerts@hdfcbank.net,instaalerts@hdfcbank.net
